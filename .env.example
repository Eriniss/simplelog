LOGTO_ENDPOINT=https://your-logto-endpoint.com/
# Optional: Internal endpoint for server-to-server communication (avoids routing loops)
# If Logto is on same server, use: http://localhost:3001/ or container name
# LOGTO_INTERNAL_ENDPOINT=http://localhost:3001/
LOGTO_APP_ID=your_app_id
LOGTO_APP_SECRET=your_app_secret
LOGTO_REDIRECT_URI=http://localhost:3000/oidc/callback
LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:8080
PORT=3000

# Frontend URL (for login redirect)
# Development: http://localhost:8080
# Production: https://blog.polipixel.link
FRONTEND_URL=http://localhost:8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=simplelog
DB_PASSWORD=simplelog_password
DB_NAME=simplelog
