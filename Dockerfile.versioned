# Multi-stage build for SimpleLog with configurable Go version
# Build with: docker build --build-arg GO_VERSION=1.23 -f Dockerfile.versioned -t simplelog .

ARG GO_VERSION=latest

FROM golang:${GO_VERSION}-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates gcc musl-dev sqlite-dev

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application with CGO enabled for SQLite
RUN CGO_ENABLED=1 GOOS=linux go build -a -ldflags '-linkmode external -extldflags "-static"' -o simplelog .

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates sqlite

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/simplelog .

# Copy static files
COPY --from=builder /app/public ./public

# Copy .env file (embedded in the image)
COPY .env .env

# Create data directory for SQLite database
RUN mkdir -p /root/data

# Create uploads directory for images
RUN mkdir -p /root/public/uploads && chmod 755 /root/public/uploads

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/posts || exit 1

# Run the application
CMD ["./simplelog"]
